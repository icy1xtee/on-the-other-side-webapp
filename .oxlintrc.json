{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["engine/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@/",
                "message": "engine/ is independent of the app: no imports from src/ (FSD layers, content). Scenes are passed in from outside."
              },
              {
                "regex": "^(\\.\\./)+src(/|$)",
                "message": "engine/ is independent of the app: no imports from src/ (FSD layers, content). Scenes are passed in from outside."
              },
              {
                "regex": "^(react|react-dom|mobx|mobx-react-lite|styled-components)(/|$)",
                "message": "engine/ is pure TypeScript: no React, no MobX. The app wraps it in its own stores."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./)+engine(/|$)",
                "message": "Import the engine through its public API: `from '@engine'`."
              }
            ]
          }
        ]
      }
    }
  ]
}
